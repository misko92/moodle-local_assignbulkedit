{{!
    @template local_assignbulkedit/create

    Form for creating several assignments as copies of a model assignment.

    Example context (json):
    {
        "actionurl": "https://example.com/local/assignbulkedit/create.php?id=2",
        "courseid": 2,
        "sesskey": "abc",
        "models": [{"value": 5, "label": "Lab 1", "selected": true}],
        "hidden": false,
        "preview": true,
        "previewsummary": "1 assignment(s) will be created as copies of Lab 1:",
        "previewrows": [{"name": "Lab 2", "section": "Topic 1", "allowsubmissionsfromdate": "(none)",
            "duedate": "Friday, 9 October 2026, 5:00 PM", "cutoffdate": "(none)", "gradingduedate": "(none)"}],
        "rows": [{
            "index": 0, "name": "Lab 2", "nameerror": null, "sectionerror": null,
            "sections": [{"value": 1, "label": "Topic 1", "selected": true}],
            "dates": [{"field": "duedate", "value": "2026-10-09T17:00", "label": "Due date", "error": null}]
        }]
    }
}}
<form method="post" action="{{actionurl}}" id="local_assignbulkedit_create">
    <input type="hidden" name="sesskey" value="{{sesskey}}">

    <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
        <div>
            <label for="local_assignbulkedit_model" class="form-label mb-1">{{#str}} createmodel, local_assignbulkedit {{/str}}</label>
            <select name="model" id="local_assignbulkedit_model" class="form-select" aria-describedby="local_assignbulkedit_modelhelp">
                {{#models}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/models}}
            </select>
        </div>
        <div class="form-check mb-2">
            <input type="checkbox" class="form-check-input" name="hidden" value="1" id="local_assignbulkedit_hidden"{{#hidden}} checked{{/hidden}}>
            <label for="local_assignbulkedit_hidden" class="form-check-label">{{#str}} createhidden, local_assignbulkedit {{/str}}</label>
        </div>
        <div id="local_assignbulkedit_modelhelp" class="form-text w-100 mt-0">{{#str}} createmodel_help, local_assignbulkedit {{/str}}</div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle generaltable">
            <thead>
                <tr>
                    <th scope="col">{{#str}} name, local_assignbulkedit {{/str}}</th>
                    <th scope="col">{{#str}} section {{/str}}</th>
                    <th scope="col">{{#str}} allowsubmissionsfromdate, local_assignbulkedit {{/str}}</th>
                    <th scope="col">{{#str}} duedate, local_assignbulkedit {{/str}}</th>
                    <th scope="col">{{#str}} cutoffdate, local_assignbulkedit {{/str}}</th>
                    <th scope="col"><span class="visually-hidden">{{#str}} createremoverow, local_assignbulkedit {{/str}}</span></th>
                </tr>
            </thead>
            <tbody data-region="rows">
                {{#rows}}
                <tr data-region="row">
                    <td>
                        <label for="local_assignbulkedit_r{{index}}_name" class="visually-hidden">{{#str}} name, local_assignbulkedit {{/str}}</label>
                        <input type="text" name="r[{{index}}][name]" id="local_assignbulkedit_r{{index}}_name" value="{{name}}"
                               class="form-control form-control-sm{{#nameerror}} is-invalid{{/nameerror}}" data-field="name" size="30">
                        {{#nameerror}}<div class="invalid-feedback">{{.}}</div>{{/nameerror}}
                    </td>
                    <td>
                        <label for="local_assignbulkedit_r{{index}}_section" class="visually-hidden">{{#str}} section {{/str}}</label>
                        <select name="r[{{index}}][section]" id="local_assignbulkedit_r{{index}}_section"
                                class="form-select form-select-sm{{#sectionerror}} is-invalid{{/sectionerror}}" data-field="section">
                            {{#sections}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/sections}}
                        </select>
                        {{#sectionerror}}<div class="invalid-feedback">{{.}}</div>{{/sectionerror}}
                    </td>
                    {{#dates}}
                    <td>
                        <label for="local_assignbulkedit_r{{index}}_{{field}}" class="visually-hidden">{{label}}</label>
                        <input type="datetime-local" name="r[{{index}}][{{field}}]" id="local_assignbulkedit_r{{index}}_{{field}}"
                               value="{{value}}" class="form-control form-control-sm{{#error}} is-invalid{{/error}}" data-field="{{field}}">
                        {{#error}}<div class="invalid-feedback">{{.}}</div>{{/error}}
                    </td>
                    {{/dates}}
                    <td>
                        <button type="button" class="btn btn-link btn-sm p-0" data-action="removerow"
                                title="{{#str}} createremoverow, local_assignbulkedit {{/str}}"
                                aria-label="{{#str}} createremoverow, local_assignbulkedit {{/str}}">{{#pix}} t/delete, core {{/pix}}</button>
                    </td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    <div class="d-flex flex-wrap align-items-start gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary" data-action="addrow">{{#str}} createaddrow, local_assignbulkedit {{/str}}</button>
        <details class="ms-2">
            <summary>{{#str}} createpaste, local_assignbulkedit {{/str}}</summary>
            <label for="local_assignbulkedit_paste" class="form-label mt-2">{{#str}} createpaste_help, local_assignbulkedit {{/str}}</label>
            <textarea id="local_assignbulkedit_paste" class="form-control mb-2" rows="5" cols="40" data-region="paste"></textarea>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="paste">{{#str}} createpasteadd, local_assignbulkedit {{/str}}</button>
        </details>
    </div>


    <button type="submit" name="previewbutton" value="1" class="btn {{#preview}}btn-secondary{{/preview}}{{^preview}}btn-primary{{/preview}}">
        {{#str}} ovpreview, local_assignbulkedit {{/str}}
    </button>
    {{#preview}}
    <div class="card mt-3" data-region="preview">
        <div class="card-body">
            <h3 class="h5">{{#str}} ovpreviewheading, local_assignbulkedit {{/str}}</h3>
            <p>{{previewsummary}}</p>
            <div class="table-responsive">
                <table class="table table-sm generaltable mb-2">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} name, local_assignbulkedit {{/str}}</th>
                            <th scope="col">{{#str}} section {{/str}}</th>
                            <th scope="col">{{#str}} allowsubmissionsfromdate, local_assignbulkedit {{/str}}</th>
                            <th scope="col">{{#str}} duedate, local_assignbulkedit {{/str}}</th>
                            <th scope="col">{{#str}} cutoffdate, local_assignbulkedit {{/str}}</th>
                            <th scope="col">{{#str}} gradingduedate, local_assignbulkedit {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#previewrows}}
                        <tr>
                            <td>{{name}}</td>
                            <td>{{section}}</td>
                            <td>{{allowsubmissionsfromdate}}</td>
                            <td>{{duedate}}</td>
                            <td>{{cutoffdate}}</td>
                            <td>{{gradingduedate}}</td>
                        </tr>
                        {{/previewrows}}
                    </tbody>
                </table>
            </div>
            <button type="submit" name="createbutton" value="1" class="btn btn-primary">{{#str}} createbutton, local_assignbulkedit {{/str}}</button>
        </div>
    </div>
    {{/preview}}
</form>
{{#js}}
    require(['local_assignbulkedit/create'], function(create) {
        create.init('local_assignbulkedit_create');
    });
{{/js}}
